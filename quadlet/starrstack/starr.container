[Unit]
Description=Starr unified Arr container
Requires=qbittorrent.service
After=qbittorrent.service

[Container]
Image=ghcr.io/alexandrefoley/starrstack:latest
ContainerName=starr
Network=starrstack.network
PodmanArgs=--tty # so the logs are visible with journalctl [--user] -u starr.service
PublishPort=7878:7878
PublishPort=8989:8989
PublishPort=9696:9696

Volume=./mounts/config:/config:Z
Volume=./mounts/media:/media:z

Environment=RADARR__AUTH__ENABLED=true
Environment=RADARR__SERVER__URLBASE=
Environment=RADARR__SERVER__PORT=7878
Environment=RADARR__AUTH__METHOD=External
Secret=radarr_apikey,type=env,target=RADARR__AUTH__APIKEY

Environment=SONARR__AUTH__ENABLED=true
Environment=SONARR__SERVER__URLBASE=
Environment=SONARR__SERVER__PORT=8989
Environment=SONARR__AUTH__METHOD=External
Secret=sonarr_apikey,type=env,target=SONARR__AUTH__APIKEY

Environment=PROWLARR__AUTH__ENABLED=true
Environment=PROWLARR__SERVER__URLBASE=
Environment=PROWLARR__SERVER__PORT=9696
Environment=PROWLARR__AUTH__METHOD=External
Secret=prowlarr_apikey,type=env,target=PROWLARR__AUTH__APIKEY

Environment=TORRENT_CLIENT=qbittorrent
Environment=TORRENT_HOST=qbittorrent
Environment=TORRENT_PORT=8080
Environment=TORRENT_USERNAME=starruser
Environment=TORRENT_CATEGORY_MOVIES=radarr
Environment=TORRENT_CATEGORY_TV=sonarr
Secret=webui_password,type=env,target=TORRENT_PASSWORD

[Service]
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
