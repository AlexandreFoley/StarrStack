[Unit]
Description=Monitor critical services and exit on failure
After=qbittorrent.service starr.service
Requires=qbittorrent.service starr.service

[Service]
Type=oneshot
ExecStart=/usr/local/bin/monitor-services.sh
RemainAfterExit=yes
OnFailure=poweroff.target

[Install]
WantedBy=multi-user.target
