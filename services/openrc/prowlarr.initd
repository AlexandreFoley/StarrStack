#!/sbin/openrc-run
# OpenRC equivalent of /etc/systemd/system/prowlarr.service
# (generated by scripts/arrstack-install.sh from the Prowlarr builder stage).
name="prowlarr"
description="Prowlarr Daemon"
command="/opt/Prowlarr/Prowlarr"
command_args="-nobrowser -data=/config/prowlarr"
command_user="prowlarr:root"
supervisor="supervise-daemon"
respawn_delay="2"
# respawn_max=0 means unlimited (unit: Restart=on-failure never gives up).
# ponytail: supervise-daemon respawns on any exit, systemd only on unclean exit - fine in practice.
respawn_max="0"

depend() {
	# unit: initialize.service has Before=prowlarr... (and its failure stops the container)
	need initialize
}

start_pre() {
	# unit: UMask=0002 - required by the /media group-writable scheme
	umask 0002
	checkpath --directory --mode 0755 /run/prowlarr
}