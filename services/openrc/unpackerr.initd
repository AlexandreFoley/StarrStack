#!/sbin/openrc-run
# OpenRC equivalent of /usr/lib/systemd/system/unpackerr.service (golift unit)
# plus the ubi override: Group=root, UMask=0002.
name="unpackerr"
description="unpackerr - archive extraction daemon"
command="/usr/bin/unpackerr"
command_user="unpackerr:root"
supervisor="supervise-daemon"
respawn_delay="2"
# respawn_max=0 means unlimited (unit: Restart=always never gives up).
# ponytail: supervise-daemon respawns on any exit, systemd only per Restart= - fine in practice.
respawn_max="0"

depend() {
	# initialize.sh writes our environment drop-in; must run first
	need initialize
}

start_pre() {
	# unit: UMask=0002 - required by the /media group-writable scheme
	umask 0002
	checkpath --directory --mode 0755 /run/unpackerr
	# initialize.sh stores the arr service credentials in a systemd drop-in
	# (/etc/systemd/system/unpackerr.service.d/environment.conf). OpenRC never
	# reads drop-ins, so export the same UN_* variables for the daemon here.
	envfile=/etc/systemd/system/unpackerr.service.d/environment.conf
	[ -f "$envfile" ] && eval "$(sed -n 's/^Environment="\([^"]*\)"$/export \1/p' "$envfile")"
}