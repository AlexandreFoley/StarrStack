#!/sbin/openrc-run
# OpenRC equivalent of /etc/systemd/system/radarr.service
# (generated by scripts/arrstack-install.sh from the Radarr builder stage).
name="radarr"
description="Radarr Daemon"
command="/opt/Radarr/Radarr"
command_args="-nobrowser -data=/config/radarr"
command_user="radarr:root"
supervisor="supervise-daemon"
respawn_delay="2"
# respawn_max=0 means unlimited (unit: Restart=on-failure never gives up).
# ponytail: supervise-daemon respawns on any exit, systemd only on unclean exit - fine in practice.
respawn_max="0"

depend() {
	# unit: initialize.service has Before=radarr... (and its failure stops the container)
	need initialize
}

# unit: UMask=0002. Must be an initd VARIABLE, not a start_pre `umask`
# builtin: supervise-daemon does umask(022) itself and clobbers the inherited
# value, so the builtin never reaches the daemon (verified empirically).
umask="0002"