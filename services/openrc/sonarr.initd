#!/sbin/openrc-run
# OpenRC equivalent of /etc/systemd/system/sonarr.service
# (generated by scripts/arrstack-install.sh from the Sonarr builder stage).
name="sonarr"
description="Sonarr Daemon"
command="/opt/Sonarr/Sonarr"
command_args="-nobrowser -data=/config/sonarr"
command_user="sonarr:root"
supervisor="supervise-daemon"
respawn_delay="2"
# respawn_max=0 means unlimited (unit: Restart=on-failure never gives up).
# ponytail: supervise-daemon respawns on any exit, systemd only on unclean exit - fine in practice.
respawn_max="0"

depend() {
	# unit: initialize.service has Before=sonarr... (and its failure stops the container)
	need initialize
}

start_pre() {
	# unit: UMask=0002 - required by the /media group-writable scheme
	umask 0002
	checkpath --directory --mode 0755 /run/sonarr
}